/**
 * Gets an atomic concept.
 */
private Concept AtomicConcept() throws FuzzyOntologyException :
{
	Token t;
	Concept c;
}
{
	t = <IDENTIFIER>
	{
		c = kb.getConcept(t.image);
	}
	{
		return c;
	}
|
	<TOP>
	{
		return Concept.CONCEPT_TOP;
	}
|
	<BOTTOM>
	{
		return Concept.CONCEPT_BOTTOM;
	}
}


/**
 * Gets a fuzzy role.
 */
private String Role() :
{
	Token t;
}
{
	t = <IDENTIFIER>
	{
		return t.image;
	}
}


/**
 * Gets a degree.
 */
private Degree Degree() :
{
  Double num = 1.0;
  Expression expr;
  Token t;
  String name;
}
{
	LOOKAHEAD(2)
	t = <IDENTIFIER>
	{
		name = t.image;
		Object o = truthConstants.get(name);
		if (o !=  null)
			return Degree.getDegree((Double) o);
		else
			return Degree.getDegree(kb.milp.getVariable(name));
	}
|
	LOOKAHEAD(2)
	expr = Expression()
	{
		return Degree.getDegree(expr);
	}
|
	(LOOKAHEAD(2) num = Number())?
	{
		return Degree.getDegree(num);
	}
}


/**
 * Gets a variable.
 */
private Variable Variable() :
{
	Token t;
}
{
	t = <IDENTIFIER>
	{
		return kb.milp.getVariable(t.image);
	}
	}
	
	
	/**
	 * Gets a real number.
	 */
	private double Number() :
	{
		Token n;
	}
	{
	n = <NUMBER>
	{
		return Double.parseDouble(n.image);
	}
}


/**
 * Gets a String from a Token.
 */
String getString() :
{
	Token t;
}
{
	t = <IDENTIFIER>
	{
		return t.image;
	}
}


/**
 * Gets a fuzzyDL representation of the type "string" for the range of concrete features
 */
String StringType() :
{
	Token t;
}
{
	t = <STRING_TYPE>
	{
		return t.image;
	}
}


/**
 * Gets a fuzzyDL representation of the numerical types for the range of concrete features
 */
String NumericalType() :
{
	Token t;
}
{
	t = <NUMBER_TYPE>
	{
		return t.image;
	}
}


