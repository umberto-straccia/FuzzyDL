                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#hasMWarranty"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#SellerMWarr"/>
            </owl:Restriction>
        </owl:equivalentClass>
    </owl:Class>
    


