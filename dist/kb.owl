    <!-- http://www.semanticweb.org/ontologies/myOntologies.owl#B1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/myOntologies.owl#B1">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#hasPrice"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#ls22300_22750"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#hasAlarmSystem"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#AlarmSystem"/>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/myOntologies.owl#B2 -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/myOntologies.owl#B2">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#hasInsurance"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#DriverInsurance"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#hasInsurance"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/myOntologies.owl#FireInsurance"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/myOntologies.owl#TheftInsurance"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/myOntologies.owl#B3 -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/myOntologies.owl#B3">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#hasAirConditioning"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#AirConditioning"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#hasExColor"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/myOntologies.owl#ExColorBlack"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/myOntologies.owl#ExColorGray"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


