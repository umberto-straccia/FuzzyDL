    <!-- http://www.semanticweb.org/ontologies/myOntologies.owl#AlarmSystem -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/myOntologies.owl#AlarmSystem"/>
    


    <!-- http://www.semanticweb.org/ontologies/myOntologies.owl#AstonMartin -->

