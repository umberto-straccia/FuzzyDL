    <!-- http://www.semanticweb.org/ontologies/myOntologies.owl#S1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/myOntologies.owl#S1">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#hasPrice"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#rs225000_22750"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#hasNavigator"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#NavigatorPack"/>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/myOntologies.owl#S2 -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/myOntologies.owl#S2">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#hasInsurance"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#InsurancePlus"/>
            </owl:Restriction>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/myOntologies.owl#S3 -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/myOntologies.owl#S3">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#hasKMWarranty"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/myOntologies.owl#SellerKmWarr"/>
            </owl:Restriction>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/myOntologies.owl#S4 -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/myOntologies.owl#S4">
        <owl:equivalentClass>
